# n8n Environment Configuration
# Copy this file to .env and customize values as needed

# n8n Host and Port Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Use secure cookies (set to true for HTTPS/production)
N8N_SECURE_COOKIE=false

# Webhook configuration (used for trigger URLs)
WEBHOOK_URL=http://localhost:5678/

# Optional: Database Configuration (uncomment to use PostgreSQL)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=postgres
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=your_secure_password

# Node environment
NODE_ENV=production
